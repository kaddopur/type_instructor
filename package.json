{
  "name": "type_instructor",
  "version": "0.1.0",
  "private": true,
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "vite": "^8.3.4",
    "sw-precache": "^4.0.0",
    "@playwright/test": "^1.64.1"
  },
  "dependencies": {
    "classnames": "^2.5.1",
    "lodash": "^4.18.1",
    "normalize.css": "^8.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.4.0",
    "zustand": "^5.0.15"
  },
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "vite build && sw-precache --navigate-fallback='index.html' --root='dist/' --static-file-globs='dist/**/!(*map*)'",
    "preview": "vite preview",
    "test": "node --test tests/baseline.test.mjs",
    "test:baseline": "node --test tests/baseline.test.mjs",
    "test:smoke": "playwright test"
  },
  "type": "module",
  "engines": {
    "node": ">=22.22.0 <23"
  },
  "overrides": {
    "sw-precache": {
      "meow": {
        "trim-newlines": "^3.0.1"
      }
    }
  }
}
