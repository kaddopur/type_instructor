{
  "name": "type_instructor",
  "version": "0.1.0",
  "private": true,
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/lodash": "^4.17.26",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "simple-git-hooks": "2.14.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "workbox-build": "^7.4.1"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lodash": "^4.18.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.4.0",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.15"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "dev": "vite",
    "start": "vite",
    "build": "vite build && node scripts/build-sw.js",
    "preview": "vite preview",
    "test": "pnpm test:unit",
    "test:a11y": "playwright test --grep @a11y",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --project=chromium-desktop --grep @smoke",
    "screenshots:landing": "pnpm build && node scripts/capture-landing-screenshots.mjs",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "lint:staged": "lint-staged",
    "prepare": "simple-git-hooks"
  },
  "type": "module",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "packageManager": "pnpm@11.22.0",
  "simple-git-hooks": {
    "pre-commit": "pnpm lint:staged"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,ts,tsx}": [
      "eslint --fix --max-warnings 0 --no-warn-ignored",
      "prettier --write",
      "eslint --max-warnings 0 --no-warn-ignored"
    ],
    "*.{css,json,jsonc,md,yml,yaml,html}": "prettier --write"
  }
}
